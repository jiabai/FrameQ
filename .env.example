# Locus desktop local settings template.
# This file is copied into installer resources as resources/.env.template.
# Runtime user settings live in app-local data, not in the repository root.
# Insight LLM configuration is managed by the Locus server Admin Web.
# Do not put APP_LLM_* keys here.

# Optional output directory for generated videos, transcripts, and insights.
# Leave blank to use app-local data outputs/.
APP_OUTPUT_DIR=

# Local ASR model for new transcription tasks.
APP_ASR_MODEL=iic/SenseVoiceSmall-onnx

# Optional release ASR model download overrides.
# APP_ASR_MODEL_DOWNLOAD_URL=
# APP_ASR_MODEL_DOWNLOAD_SHA256=
# APP_MODELSCOPE_ENDPOINT=
# APP_SENSEVOICE_REVISION=master

# Settings schema version used for one-time migrations. Leave it as is.
APP_SETTINGS_SCHEMA_VERSION=2
