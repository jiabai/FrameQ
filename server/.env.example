# FrameQ account and activation service configuration.
# Do not commit real secrets.

NODE_ENV=development
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8787
#
# Production must set this to true or false explicitly.
# Development/test default to disabled when omitted.
APP_SELF_SERVICE_ACTIVATION_ENABLED=false
# Prisma resolves relative SQLite URLs from server/prisma/schema.prisma.
DATABASE_URL=file:../data/frameq.sqlite
APP_ADMIN_EMAIL=lantianye@163.com

# Encrypts the dedicated FrameQ-client LLM API key before storing it in SQLite.
# Use a long random value in production, for example 32+ random bytes encoded as hex.
APP_LLM_CONFIG_ENCRYPTION_KEY=

# SMTP email OTP delivery. Production requires every SMTP value below.
# Self-service activation email also requires every SMTP value below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Development/test only. Required when SMTP is omitted; forbidden in production.
# This deliberately prints login codes to the local console.
APP_ALLOW_CONSOLE_OTP=1
