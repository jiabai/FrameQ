---
/**
 * 首页 — 按 spec § 首页 section 清单 1-9 顺序实现。
 *
 * Section 顺序：Header(BaseLayout) → Hero → Workflow → TrustBoundary →
 * OutputPreview → Supported Sources → Download Entry → FAQ → Footer(BaseLayout)
 *
 * 见 docs/product-specs/2026-08-05-web-marketing-site.md § Information Architecture。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WorkflowSteps from '../components/WorkflowSteps.astro';
import TrustBoundary from '../components/TrustBoundary.astro';
import OutputPreview from '../components/OutputPreview.astro';
import FAQ from '../components/FAQ.astro';
import LanguageHint from '../components/LanguageHint.astro';
import {
  PRODUCT_NAME,
  PRODUCT_CATEGORY,
  SUPPORTED_SOURCES,
  UNSUPPORTED_SOURCES,
  LATEST_VERSION,
  ASR_MODEL_NOTICE,
  DOWNLOAD_ASSETS,
} from '../consts';

/** 平台可用性摘要 */
const platforms = [...new Set(DOWNLOAD_ASSETS.map((a) => a.platform))];
---

<BaseLayout
  title={`${PRODUCT_NAME} — ${PRODUCT_CATEGORY}`}
  description={`${PRODUCT_NAME} 是本地优先的视频转文字与 AI 整理桌面工具。默认本地处理视频、音频和文字稿；AI 整理需你确认后才会调用云端 LLM。`}
>
  <Hero />

  <WorkflowSteps />

  <TrustBoundary />

  <OutputPreview />

  <!-- 6. Supported Sources -->
  <section class="section sources grain-overlay" id="sources">
    <div class="container">
      <header class="sources__header reveal">
        <h2 class="sources__title">支持的来源与已知限制</h2>
        <p class="sources__lede">
          FrameQ 处理公开视频。私有、会员、登录或年龄限制内容不在范围内。
        </p>
      </header>

      <div class="sources__grid">
        <div class="sources__group reveal" data-reveal data-reveal-delay="0">
          <h3 class="sources__group-title">
            <span class="sources__dot sources__dot--supported" aria-hidden="true"></span>
            当前支持
          </h3>
          <ul class="sources__list">
            {SUPPORTED_SOURCES.map((source) => (
              <li>{source}</li>
            ))}
          </ul>
        </div>

        <div class="sources__group reveal" data-reveal data-reveal-delay="80">
          <h3 class="sources__group-title">
            <span class="sources__dot sources__dot--unsupported" aria-hidden="true"></span>
            不支持
          </h3>
          <ul class="sources__list">
            {UNSUPPORTED_SOURCES.map((source) => (
              <li>{source}</li>
            ))}
            <li>平台账号登录、浏览器 cookie 导入或代理绕过</li>
            <li>批量队列或 Playlists</li>
          </ul>
        </div>
      </div>

      <p class="sources__note reveal" data-reveal data-reveal-delay="160">
        外部视频平台页面或接口可能变化，公开链接下载能力仍受平台可用性影响。
      </p>
    </div>
  </section>

  <!-- 7. Download Entry -->
  <section class="section download-entry" id="download-entry">
    <div class="container">
      <div class="download-entry__inner reveal" data-reveal>
        <div class="download-entry__content">
          <h2 class="download-entry__title">下载 FrameQ</h2>
          <p class="download-entry__version">
            当前版本 <span class="mono">{LATEST_VERSION}</span> · 支持 {platforms.join('、')}
          </p>
          <p class="download-entry__notice">{ASR_MODEL_NOTICE}</p>
          <div class="download-entry__actions">
            <a href="/download" class="download-entry__cta">
              查看下载选项
              <svg class="download-entry__cta-arrow" aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M3 7H11M11 7L7 3M11 7L7 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="download-entry__lang">
          <LanguageHint />
        </div>
      </div>
    </div>
  </section>

  <FAQ />
</BaseLayout>

<style>
  /* ---- Supported Sources ---- */
  .sources {
    background: var(--color-paper-2);
    border-block: var(--rule-hairline) solid var(--color-rule-2);
  }

  .sources__header {
    margin-bottom: var(--space-12);
    max-width: var(--content-max-narrow);
  }

  .sources__title {
    font-size: var(--text-3xl);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .sources__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  .sources__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .sources__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sources__group-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-ink);
  }

  .sources__dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .sources__dot--supported {
    background: var(--color-accent);
  }

  .sources__dot--unsupported {
    background: var(--color-destructive);
  }

  .sources__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sources__list li {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: var(--leading-snug);
    padding-left: var(--space-3);
    position: relative;
    transition: padding-left var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  .sources__list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* Round 2 P2-5：hover 时缩进 + accent 破折号 */
  .sources__list li:hover {
    padding-left: var(--space-5);
    color: var(--color-ink);
  }

  .sources__list li:hover::before {
    color: var(--color-accent);
  }

  .sources__note {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---- Download Entry ---- */
  .download-entry {
    background: var(--color-paper);
  }

  .download-entry__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .download-entry__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 48rem;
  }

  .download-entry__title {
    font-size: var(--text-3xl);
    font-weight: 600;
  }

  .download-entry__version {
    font-size: var(--text-base);
    color: var(--color-ink-2);
  }

  .download-entry__notice {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
  }

  .download-entry__actions {
    margin-top: var(--space-4);
  }

  .download-entry__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--button-padding-x);
    padding-block: var(--button-padding-y);
    background: var(--button-bg);
    color: var(--button-fg);
    border: var(--rule-hairline) solid var(--button-border);
    border-radius: var(--button-radius);
    font-family: var(--font-heading);
    font-size: var(--button-font-size);
    font-weight: var(--button-font-weight);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .download-entry__cta:hover {
    background: var(--button-bg-hover);
    color: var(--button-fg);
  }

  .download-entry__cta:active {
    transform: translateY(1px);
  }

  .download-entry__cta-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .download-entry__cta:hover .download-entry__cta-arrow {
    transform: translateX(2px);
  }

  .download-entry__lang {
    flex-shrink: 0;
  }

  /* ---- 移动端 ---- */
  @media (max-width: 768px) {
    .sources__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .download-entry__inner {
      flex-direction: column;
    }
  }
</style>
