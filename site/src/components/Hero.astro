---
/**
 * Hero — H2 Split diptych archetype。
 *
 * Round 1 视觉活力改造：
 * - 7:5 不对称布局（原 1:1 等分缺乏张力）
 * - Hero title 用 Fraunces serif display，形成 sans body + serif display 对比
 * - ASCII 图标 ◇ 替换为 inline SVG（gate 30）
 * - 添加 hero-glow radial bloom 背景层
 * - reveal staggered entrance
 * - trust card dot 替换为 SVG（更精致）
 *
 * 见 docs/exec-plans/completed/2026-08-05-web-marketing-site-plan.md Task 4.4
 */
import {
  PRODUCT_NAME,
  PRODUCT_CATEGORY,
  TRUST_COPY,
  WORKFLOW_COPY,
} from '../consts';
---

<section class="hero grain-overlay">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <!-- 左侧：headline + lede + CTAs -->
    <div class="hero__content">
      <p class="hero__eyebrow reveal">
        <span class="hero__eyebrow-mark" aria-hidden="true"></span>
        本地优先 · 开源
      </p>
      <h1 class="hero__title reveal" data-reveal data-reveal-delay="80">
        {PRODUCT_NAME}
      </h1>
      <p class="hero__category reveal" data-reveal data-reveal-delay="160">
        <span class="hero__category-em">视频转文字</span>与 <span class="hero__category-em">AI 整理</span>桌面工具
      </p>
      <p class="hero__trust reveal" data-reveal data-reveal-delay="240">{TRUST_COPY}</p>

      <div class="hero__actions reveal" data-reveal data-reveal-delay="320">
        <a href="/download" class="hero__cta-primary">
          下载 {PRODUCT_NAME}
          <svg class="hero__cta-arrow" aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 7H11M11 7L7 3M11 7L7 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#workflow" class="hero__cta-secondary">
          查看工作流
        </a>
      </div>

      <p class="hero__workflow-hint reveal" data-reveal data-reveal-delay="400">{WORKFLOW_COPY}</p>
    </div>

    <!-- 右侧：Trust Boundary 卡片 -->
    <aside class="hero__trust-card reveal reveal--slide-right" data-reveal data-reveal-delay="200" aria-label="数据信任边界">
      <div class="trust-card__header">
        <svg class="trust-card__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 1L14 4V8C14 11.5 11.5 14 8 15C4.5 14 2 11.5 2 8V4L8 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M5.5 8L7.5 10L10.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="trust-card__label">数据边界</span>
      </div>

      <div class="trust-card__group">
        <h3 class="trust-card__group-title trust-card__group-title--local">
          <svg class="trust-card__dot" aria-hidden="true" width="8" height="8" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="3.5" fill="currentColor"/>
          </svg>
          默认留在本机
        </h3>
        <ul class="trust-card__list">
          <li>视频与音频源</li>
          <li>转写文字稿</li>
          <li>模型缓存</li>
          <li>历史任务记录</li>
        </ul>
      </div>

      <div class="trust-card__group">
        <h3 class="trust-card__group-title trust-card__group-title--cloud">
          <svg class="trust-card__dot" aria-hidden="true" width="8" height="8" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="3.5" fill="currentColor"/>
          </svg>
          仅在你确认后离开
        </h3>
        <ul class="trust-card__list">
          <li>AI 总结的 prompt 文本</li>
          <li>由 server-managed LLM checkout 承载</li>
        </ul>
      </div>

      <div class="trust-card__group">
        <h3 class="trust-card__group-title trust-card__group-title--never">
          <svg class="trust-card__dot" aria-hidden="true" width="8" height="8" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="3.5" fill="currentColor"/>
          </svg>
          绝不包含
        </h3>
        <ul class="trust-card__list">
          <li>安装包内置 ASR 权重</li>
          <li>LLM key 与云端模型</li>
          <li>私有视频访问凭据</li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-32) var(--space-24);
    padding-top: var(--space-32);
    /* hero-glow 作为背景层 */
    background: var(--color-paper);
  }

  /* Round 1：radial bloom 背景层，为 paper 添加大气感 */
  .hero__glow {
    position: absolute;
    inset: 0;
    background: var(--hero-glow);
    pointer-events: none;
    z-index: 0;
  }

  .hero > .container {
    position: relative;
    z-index: 1;
  }

  /* Round 1：7:5 不对称布局，替代原 1:1 等分 */
  .hero__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-16);
    align-items: start;
  }

  /* ---- 左侧内容 ---- */
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Round 1：eyebrow 小标签，增加 editorial 层次 */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0;
    margin-bottom: var(--space-1);
  }

  .hero__eyebrow-mark {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
    border-radius: 50%;
  }

  /* Round 2 P1-1：hero title 放大到 display-xl，line-height 收紧到 0.9，形成最大张力 */
  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-display-xl);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.9;
    color: var(--color-ink);
    font-optical-sizing: auto;
    overflow-wrap: anywhere;
    min-width: 0;
    margin: 0;
  }

  /* Round 2 P1-1：category 用 Fraunces italic 强调关键词，形成 sans body + serif italic 对比。
     gate 38a 约束仅作用于 headings，<p> 不受 roman-only 限制。 */
  .hero__category {
    font-family: var(--font-text);
    font-size: var(--text-2xl);
    color: var(--color-ink-2);
    font-weight: 400;
    line-height: var(--leading-snug);
    margin: 0;
    margin-top: var(--space-1);
  }

  .hero__category-em {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    color: var(--color-ink);
    font-optical-sizing: auto;
  }

  .hero__trust {
    font-size: var(--text-base);
    color: var(--color-ink-2);
    line-height: var(--leading-relaxed);
    max-width: 42ch;
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* ---- Primary CTA — 8 states ---- */
  .hero__cta-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--button-padding-x);
    padding-block: var(--button-padding-y);
    background: var(--button-bg);
    color: var(--button-fg);
    border: var(--rule-hairline) solid var(--button-border);
    border-radius: var(--button-radius);
    font-family: var(--font-ui);
    font-size: var(--button-font-size);
    font-weight: var(--button-font-weight);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .hero__cta-primary:hover {
    background: var(--button-bg-hover);
  }

  .hero__cta-primary:active {
    transform: translateY(1px);
  }

  .hero__cta-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .hero__cta-primary:hover .hero__cta-arrow {
    transform: translateX(2px);
  }

  /* ---- Secondary CTA (outlined) ---- */
  .hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    padding-inline: var(--button-padding-x);
    padding-block: var(--button-padding-y);
    background: var(--button-secondary-bg);
    color: var(--button-secondary-fg);
    border: var(--rule-hairline) solid var(--button-secondary-border);
    border-radius: var(--button-radius);
    font-family: var(--font-ui);
    font-size: var(--button-font-size);
    font-weight: var(--button-font-weight);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .hero__cta-secondary:hover {
    background: var(--button-secondary-bg-hover);
    border-color: var(--color-rule);
  }

  .hero__workflow-hint {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: var(--space-2);
  }

  /* ---- 右侧 Trust Card ---- */
  .hero__trust-card {
    background: var(--card-bg);
    border: var(--rule-hairline) solid var(--card-border);
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    box-shadow: var(--card-shadow-rest);
  }

  .trust-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: var(--rule-hairline) solid var(--color-rule-2);
  }

  .trust-card__icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .trust-card__label {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .trust-card__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .trust-card__group-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0;
  }

  .trust-card__dot {
    flex-shrink: 0;
  }

  .trust-card__group-title--local {
    color: var(--color-ink);
  }
  .trust-card__group-title--local .trust-card__dot {
    color: var(--color-accent);
  }

  .trust-card__group-title--cloud {
    color: var(--color-ink);
  }
  .trust-card__group-title--cloud .trust-card__dot {
    color: var(--color-warn);
  }

  .trust-card__group-title--never {
    color: var(--color-ink);
  }
  .trust-card__group-title--never .trust-card__dot {
    color: var(--color-destructive);
  }

  .trust-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .trust-card__list li {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: var(--leading-snug);
  }

  /* ---- 移动端响应式 ---- */
  @media (max-width: 768px) {
    .hero {
      padding-block: var(--space-24) var(--space-16);
    }

    .hero__grid {
      /* 移动端单列 — gate 52 */
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero__title {
      font-size: var(--text-display-l);
    }

    .hero__category {
      font-size: var(--text-xl);
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__cta-primary,
    .hero__cta-secondary {
      justify-content: center;
    }
  }
</style>
