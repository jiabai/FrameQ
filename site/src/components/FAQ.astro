---
/**
 * FAQ — Conversational FAQ archetype（adapted）。
 *
 * 数据来自 src/content/faq/ content collection（markdown 条目）。
 * 首版用简单列表 + `<details>` accordion，问题足够简短。
 * 状态覆盖：default · hover · focus-visible · active（accordion 展开时）
 *
 * 见 docs/product-specs/2026-08-05-web-marketing-site.md § Component Inventory。
 */
import { getCollection, render } from 'astro:content';

const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const renderedFaqs = await Promise.all(
  faqs.map(async (faq) => {
    const { Content } = await render(faq);
    return { question: faq.data.question, Content };
  }),
);
---

<section class="section faq" id="faq">
  <div class="container faq__container">
    <header class="faq__header reveal">
      <h2 class="faq__title">常见问题</h2>
      <p class="faq__lede">关于模型、隐私、限制与支持的直接回答。</p>
    </header>

    <div class="faq__list">
      {renderedFaqs.map(({ question, Content }, idx) => (
        <details class="faq__item reveal" data-reveal data-reveal-delay={String(idx * 60)}>
          <summary class="faq__question">
            <span>{question}</span>
            <svg class="faq__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </summary>
          <div class="faq__answer">
            <Content />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--color-paper);
  }

  .faq__container {
    max-width: var(--content-max-narrow);
  }

  .faq__header {
    margin-bottom: var(--space-10);
  }

  .faq__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 500;
    margin-bottom: var(--space-3);
    font-optical-sizing: auto;
  }

  .faq__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: var(--rule-hairline) solid var(--color-rule-2);
  }

  .faq__item {
    border-bottom: var(--rule-hairline) solid var(--color-rule-2);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    padding-inline: var(--space-2);
    margin-inline: calc(-1 * var(--space-2));
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-sm);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  /* Round 2 P2-5：hover 添加微弱背景 + accent 色 */
  .faq__question:hover {
    color: var(--color-accent);
    background-color: var(--color-paper-2);
  }

  /* Round 1：SVG plus icon 替换 ASCII +，旋转 45° 变 x */
  .faq__icon {
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  .faq__item[open] .faq__question {
    color: var(--color-accent);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    color: var(--color-accent);
  }

  .faq__answer {
    padding-bottom: var(--space-5);
    max-width: 65ch;
  }

  .faq__answer :global(p) {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .faq__answer :global(code) {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    padding-inline: var(--space-1);
    padding-block: var(--space-1);
    background: var(--color-paper-2);
    border-radius: var(--radius-sm);
  }

  /* ---- 移动端 ---- */
  @media (max-width: 768px) {
    .faq__question {
      font-size: var(--text-sm);
      padding-block: var(--space-4);
    }

    .faq__answer :global(p) {
      font-size: var(--text-xs);
    }
  }
</style>
