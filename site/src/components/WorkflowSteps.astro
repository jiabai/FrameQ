---
/**
 * WorkflowSteps — F4 Step sequence archetype。
 *
 * Narrative Workflow 宏结构的核心：编号阶段 1.0 → 2.0 → 3.0 → 4.0 讲述产品使用流程。
 * 每个阶段有：编号 + 标题 + 说明 + 状态标签。
 *
 * 状态覆盖：default · hover · focus-visible
 */
---

<section class="section workflow grain-overlay" id="workflow">
  <div class="container">
    <header class="workflow__header reveal">
      <h2 class="workflow__title">工作流</h2>
      <p class="workflow__lede">从公开链接到可继续思考的产物，四步。</p>
    </header>

    <ol class="workflow__steps">
      <li class="workflow__step reveal" data-reveal data-reveal-delay="0">
        <div class="workflow__step-number-anchor" aria-hidden="true">
          <span class="workflow__step-number mono">1.0</span>
        </div>
        <div class="workflow__step-body">
          <h3 class="workflow__step-title">粘贴公开链接</h3>
          <p class="workflow__step-desc">
            支持抖音、B站、小红书、YouTube 的公开视频链接。FrameQ 不访问私有、会员、登录或年龄限制内容。
          </p>
          <span class="workflow__step-tag">输入</span>
        </div>
      </li>

      <li class="workflow__step reveal" data-reveal data-reveal-delay="80">
        <div class="workflow__step-number-anchor" aria-hidden="true">
          <span class="workflow__step-number mono">2.0</span>
        </div>
        <div class="workflow__step-body">
          <h3 class="workflow__step-title">提取本地媒体</h3>
          <p class="workflow__step-desc">
            本地 worker 下载视频并提取音频，归一化为 16 kHz 单声道 WAV。视频容器保留原样，所有源完整路径不进入 React、持久化或日志。
          </p>
          <span class="workflow__step-tag">视频提取</span>
        </div>
      </li>

      <li class="workflow__step reveal" data-reveal data-reveal-delay="160">
        <div class="workflow__step-number-anchor" aria-hidden="true">
          <span class="workflow__step-number mono">3.0</span>
        </div>
        <div class="workflow__step-body">
          <h3 class="workflow__step-title">本地转写</h3>
          <p class="workflow__step-desc">
            SenseVoice Small 在本机完成语音转文字。ASR 模型在首次提交已验证任务时按所选模型按需下载，不内置在安装包中。流式 ONNX VAD 与 fail-closed 转写契约保证结果可预测。
          </p>
          <span class="workflow__step-tag">视频转译</span>
        </div>
      </li>

      <li class="workflow__step reveal" data-reveal data-reveal-delay="240">
        <div class="workflow__step-number-anchor" aria-hidden="true">
          <span class="workflow__step-number mono">4.0</span>
        </div>
        <div class="workflow__step-body">
          <h3 class="workflow__step-title">可选 AI 整理</h3>
          <p class="workflow__step-desc">
            保存文字稿后，可单独确认调用云端 LLM 做进一步整理：生成总结、思维导图与结构化梳理；结合你的灵感档案与个人偏好产出富有启发的灵感；或拆解视频的叙事结构与表达手法。每次调用独立确认、有界额度，内容默认留在本机。
          </p>
          <span class="workflow__step-tag workflow__step-tag--accent">灵感启发</span>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .workflow {
    background: var(--color-paper);
  }

  .workflow__header {
    margin-bottom: var(--space-16);
    max-width: var(--content-max-narrow);
  }

  .workflow__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 500;
    margin-bottom: var(--space-3);
    /* Fraunces opsz 自动启用，editorial 性格 */
    font-optical-sizing: auto;
  }

  .workflow__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  /* ---- Steps list ---- */
  .workflow__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Round 1 视觉活力：step 改为 8rem number column + 1fr body，
     数字用巨大 outline 字号作为 editorial anchor。
     Round 2 P1-2：添加左侧 accent 边 hover 反馈 + position relative 供连接线定位。 */
  .workflow__step {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-8);
    padding-block: var(--space-10);
    border-top: var(--rule-hairline) solid var(--color-rule-2);
    transition: background-color var(--dur-fast) var(--ease-out);
    align-items: start;
    position: relative;
  }

  .workflow__step:last-child {
    border-bottom: var(--rule-hairline) solid var(--color-rule-2);
  }

  /* Round 2 P1-2：hover 时左侧 accent 边 + 微弱背景 */
  .workflow__step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .workflow__step:hover {
    background-color: var(--color-paper-2);
  }

  .workflow__step:hover::before {
    transform: scaleY(1);
  }

  /* 巨大数字 anchor — outline 样式（text-stroke + 透明 fill） */
  .workflow__step-number-anchor {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
  }

  /* Round 2 P1-2：步骤间垂直连接线，从数字下方延伸到下一步 */
  .workflow__step:not(:last-child) .workflow__step-number-anchor::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    top: 100%;
    width: 1px;
    height: calc(var(--space-10) + 1px);
    background: var(--color-rule-2);
    margin-top: var(--space-2);
  }

  .workflow__step-number {
    font-family: var(--font-code);
    font-size: var(--text-display-mono);
    font-weight: 500;
    line-height: 0.85;
    color: var(--step-number-outline-fill);
    /* text-stroke 实现 outline 数字 — 仅 webkit/blink 支持，Firefox 降级为 fill */
    -webkit-text-stroke: 1.5px var(--step-number-outline-stroke);
    /* Firefox fallback: 微弱 fill */
    @supports not (-webkit-text-stroke: 1px black) {
      color: oklch(52% 0.17 256 / 0.18);
    }
    transition: color var(--dur-base) var(--ease-out),
                -webkit-text-stroke-color var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out);
    letter-spacing: -0.04em;
    transform-origin: left center;
  }

  /* Round 2 P1-2：hover 时数字变实色 accent + 微缩放，形成更强交互反馈 */
  .workflow__step:hover .workflow__step-number {
    color: var(--color-accent);
    -webkit-text-stroke-color: var(--color-accent);
    transform: scale(1.04);
  }

  .workflow__step-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .workflow__step-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-ink);
    font-optical-sizing: auto;
    letter-spacing: -0.02em;
  }

  .workflow__step-desc {
    font-size: var(--text-base);
    color: var(--color-ink-2);
    line-height: var(--leading-relaxed);
    max-width: 65ch;
  }

  .workflow__step-tag {
    display: inline-block;
    align-self: flex-start;
    padding-inline: var(--space-3);
    padding-block: var(--space-1);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: var(--radius-full);
    border: var(--rule-hairline) solid var(--color-border);
  }

  .workflow__step-tag--accent {
    background: var(--color-accent-tint-bg);
    color: var(--color-accent);
    border-color: var(--color-accent-tint-border);
  }

  /* ---- 移动端 ---- */
  @media (max-width: 768px) {
    .workflow__step {
      /* 移动端单列 — gate 52 */
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-block: var(--space-8);
    }

    /* 移动端隐藏连接线 — 单列布局不需要 */
    .workflow__step:not(:last-child) .workflow__step-number-anchor::after {
      display: none;
    }

    .workflow__step-number {
      font-size: var(--text-3xl);
      -webkit-text-stroke-width: 1px;
    }

    .workflow__step-title {
      font-size: var(--text-xl);
    }

    .workflow__step-desc {
      font-size: var(--text-sm);
    }
  }
</style>
