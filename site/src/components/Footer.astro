---
/**
 * Footer — Ft5 Statement archetype。
 *
 * Round 1 视觉活力改造：
 * - Statement 字号放大到 display-l（原 text-2xl 太弱）
 * - 用 Fraunces serif display，形成 editorial 收尾仪式感
 * - 添加 reveal 入场动画
 *
 * 一句 display 字号的 closing line 主导，wordmark + minimal links + copyright 在下方弱化。
 * Stripe (older), Mailchimp pre-rebrand 词汇。
 *
 * 状态覆盖：default · hover · focus-visible
 */
import { PRODUCT_NAME, FOOTER_LINKS, GITHUB_URL, LATEST_VERSION } from '../consts';
const year = new Date().getFullYear();
---

<footer class="footer grain-overlay">
  <div class="container footer__inner">
    <p class="footer__statement reveal" data-reveal>
      本地优先，<span class="footer__statement-accent">精确</span>，<br/>由你掌控<span class="footer__statement-period">.</span>
    </p>

    <div class="footer__meta reveal" data-reveal data-reveal-delay="120">
      <div class="footer__brand">
        <span class="footer__brand-mark" aria-hidden="true">F</span>
        <span class="footer__brand-text">{PRODUCT_NAME}</span>
        <span class="footer__version mono">{LATEST_VERSION}</span>
      </div>

      <nav class="footer__links" aria-label="页脚导航">
        {FOOTER_LINKS.map((link) => (
          <a
            href={link.href}
            class="footer__link"
            {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <p class="footer__copyright">
        © {year} {PRODUCT_NAME}. 本地优先，开源分发。
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--rule-hairline) solid var(--footer-border);
    padding-block: var(--space-20) var(--space-8);
    margin-top: var(--space-20);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* Round 1：Statement 放大到 display-l，用 Fraunces serif 形成收尾仪式感。
     Round 2 P2-4：收紧 max-width 到 14ch，letter-spacing 加深，添加终止句号 accent。 */
  .footer__statement {
    font-family: var(--font-heading);
    font-size: var(--text-display-l);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--footer-statement-color);
    margin: 0;
    max-width: 14ch;
    font-optical-sizing: auto;
  }

  .footer__statement-accent {
    color: var(--footer-statement-accent);
    font-style: italic;
  }

  /* Round 2 P2-4：终止句号用 accent 色，形成 editorial 收尾 */
  .footer__statement-period {
    color: var(--footer-statement-accent);
  }

  /* ---- Meta ---- */
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .footer__brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .footer__version {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    color: var(--footer-meta-color);
    padding-inline: var(--space-2);
    padding-block: var(--space-1);
    background: var(--color-paper-2);
    border-radius: var(--radius-sm);
  }

  /* ---- Links ---- */
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer__link {
    color: var(--color-ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  /* ---- Copyright ---- */
  .footer__copyright {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--footer-meta-color);
    margin: 0;
  }

  /* ---- 移动端 ---- */
  @media (max-width: 768px) {
    .footer {
      padding-block: var(--space-12) var(--space-6);
    }

    .footer__statement {
      font-size: var(--text-display);
    }

    .footer__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .footer__links {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
