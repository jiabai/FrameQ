---
/**
 * DownloadCard — 单个平台下载卡片。
 *
 * 状态覆盖：default · hover · focus-visible · active · disabled
 * 平台未就绪时用 disabled 状态。
 *
 * 见 docs/product-specs/2026-08-05-web-marketing-site.md § Component Inventory。
 */
import type { DownloadAsset } from '../consts';
import { ASR_MODEL_NOTICE } from '../consts';

interface Props {
  asset: DownloadAsset;
  /** 是否禁用（平台未验证时） */
  disabled?: boolean;
  /** reveal 错峰序号，与首页卡片网格一致（index * 80ms） */
  index?: number;
}

const { asset, disabled = false, index = 0 } = Astro.props;
---

<article
  class={`download-card reveal${disabled ? ' download-card--disabled' : ''}`}
  data-reveal
  data-reveal-delay={String(index * 80)}
>
  <header class="download-card__header">
    <div class="download-card__platform">
      <h3 class="download-card__title">{asset.platform}</h3>
      <p class="download-card__arch">{asset.arch}</p>
    </div>
    <span class="download-card__file-type mono">{asset.fileType}</span>
  </header>

  <dl class="download-card__meta">
    <div class="download-card__meta-row">
      <dt class="download-card__meta-label">文件名</dt>
      <dd class="download-card__meta-value mono">{asset.filename}</dd>
    </div>
  </dl>

  <a
    href={disabled ? undefined : asset.url}
    class="download-card__button"
    aria-disabled={disabled || undefined}
    {...(disabled ? { 'data-state': 'disabled' } : {})}
    {...(!disabled && asset.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
  >
    {disabled ? '即将支持' : '下载'}
    {!disabled && (
      <svg class="download-card__button-arrow" aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M3 7H11M11 7L7 3M11 7L7 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}
  </a>

  <p class="download-card__notice">{ASR_MODEL_NOTICE}</p>
</article>

<style>
  .download-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--card-padding);
    background: var(--card-bg);
    border: var(--rule-hairline) solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow-rest);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .download-card:hover {
    border-color: var(--color-rule);
    box-shadow: var(--card-shadow-hover);
  }

  /* ---- Disabled state ---- */
  .download-card--disabled {
    opacity: 0.6;
  }

  .download-card--disabled:hover {
    border-color: var(--card-border);
    box-shadow: var(--card-shadow-rest);
  }

  .download-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .download-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
    font-optical-sizing: auto;
  }

  .download-card__arch {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin: 0;
  }

  .download-card__file-type {
    padding-inline: var(--space-2);
    padding-block: var(--space-1);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    border-radius: var(--radius-sm);
    border: var(--rule-hairline) solid var(--color-border);
    white-space: nowrap;
  }

  /* ---- Meta ---- */
  .download-card__meta {
    margin: 0;
    padding: var(--space-3) 0;
    border-top: var(--rule-hairline) solid var(--color-rule-2);
    border-bottom: var(--rule-hairline) solid var(--color-rule-2);
  }

  .download-card__meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }

  .download-card__meta-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin: 0;
  }

  .download-card__meta-value {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    margin: 0;
    text-align: right;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  /* ---- Button — 8 states ---- */
  .download-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-inline: var(--button-padding-x);
    padding-block: var(--button-padding-y);
    background: var(--button-bg);
    color: var(--button-fg);
    border: var(--rule-hairline) solid var(--button-border);
    border-radius: var(--button-radius);
    font-family: var(--font-ui);
    font-size: var(--button-font-size);
    font-weight: var(--button-font-weight);
    /* default · hover · focus-visible · active · disabled · loading · error · success */
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .download-card__button:hover {
    background: var(--button-bg-hover);
  }

  .download-card__button:active {
    transform: translateY(1px);
  }

  .download-card__button[aria-disabled='true'] {
    background: var(--color-paper-2);
    color: var(--color-muted);
    border-color: var(--color-border);
    cursor: not-allowed;
    pointer-events: none;
  }

  .download-card__button-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .download-card__button:hover .download-card__button-arrow {
    transform: translateX(2px);
  }

  /* ---- Notice ---- */
  .download-card__notice {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: var(--leading-snug);
    margin: 0;
  }
</style>
